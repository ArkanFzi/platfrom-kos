# ====================================================================
# BACKEND DATABASE CONFIGURATION
# ====================================================================
DB_HOST=localhost
DB_USER=postgres
DB_PASSWORD=change_me_to_your_password
DB_NAME=koskosan_rahmat
DB_PORT=5432

# ====================================================================
# BACKEND SECURITY
# ====================================================================
# Generate with: openssl rand -base64 32
# IMPORTANT: Must be at least 32 characters for production
JWT_SECRET=CHANGE_ME_minimum_32_characters_required_here

# ====================================================================
# BACKEND APPLICATION
# ====================================================================
PORT=8080
GIN_MODE=debug
APP_VERSION=1.0.0

# ====================================================================
# BACKEND GOOGLE OAUTH 2.0 (Optional)
# ====================================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8080/api/auth/google/callback

# ====================================================================
# BACKEND SMTP EMAIL CONFIGURATION (Optional)
# ====================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=
SMTP_PASSWORD=
CONTACT_EMAIL=

# ====================================================================
# BACKEND CLOUDINARY (Image Hosting - Optional)
# ====================================================================
# Register at cloudinary.com to get these values
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# ====================================================================
# BACKEND WHATSAPP CONFIGURATION (Fonnte - Optional)
# ====================================================================
# Get token from https://fonnte.com
FONNTE_TOKEN=
# Format: 62812345678 (with country code, no +)
ADMIN_PHONE=

# ====================================================================
# FRONTEND CONFIGURATION
# ====================================================================
# API Base URL - must match backend PORT
NEXT_PUBLIC_API_URL=http://localhost:8080/api
NEXT_PUBLIC_API_BASE=/api

# App Configuration
NEXT_PUBLIC_APP_NAME=Rahmat ZAW Prime Stay
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ====================================================================
# FRONTEND THIRD-PARTY SERVICES
# ====================================================================
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=

# ====================================================================
# FRONTEND DOMAIN & URLS (for development)
# ====================================================================
DOMAIN=localhost
NEXT_PUBLIC_SOCKET_URL=http://localhost:8080

# ====================================================================
# CORS & ALLOWED ORIGINS
# ====================================================================
ALLOWED_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# ====================================================================
# NOTES FOR PRODUCTION DEPLOYMENT
# ====================================================================
# 1. Change GIN_MODE from "debug" to "release"
# 2. Update all URLs to use HTTPS
# 3. Set proper JWT_SECRET with strong random value
# 4. Configure SMTP for email functionality
# 5. Fill in all Optional services with actual credentials
# 6. Update GOOGLE_* values if using OAuth
# 7. Set Fonnte token if using WhatsApp notifications
# ====================================================================
